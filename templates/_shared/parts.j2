{% macro icon(name, cls='') -%}
<svg class="ic {{ cls }}" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">{{ (ICONS.get(name) or ICONS['sparkle'])|safe }}</svg>
{%- endmacro %}

{# image with placeholder fallback #}
{% macro photo(path, alt='', cls='', kind='sparkle') -%}
{% if path -%}
<img class="{{ cls }}" src="{{ root }}media/{{ path }}" alt="{{ alt }}" loading="lazy">
{%- else -%}
<div class="ph {{ cls }}" role="img" aria-label="{{ alt }}">{{ icon(kind) }}</div>
{%- endif %}
{%- endmacro %}

{% macro initials(name) -%}
{%- set parts = (name or '').replace('Dr.', '').replace('Dr', '').split() -%}
{{ ((parts[0][:1] if parts else '') ~ (parts[-1][:1] if parts|length > 1 else ''))|upper }}
{%- endmacro %}

{% macro section_head(eyebrow, title, lead='', cls='') -%}
<div class="sec-head reveal {{ cls }}">
  {% if eyebrow %}<p class="eyebrow">{{ eyebrow }}</p>{% endif %}
  <h2>{{ title|accent }}</h2>
  {% if lead %}<p class="lead">{{ lead }}</p>{% endif %}
</div>
{%- endmacro %}

{% macro stats(items, cls='') -%}
<ul class="stats {{ cls }}">
  {% for it in items %}
  <li class="stat reveal">
    <span class="stat-top"><b class="stat-num" {% if it.value is number %}data-count="{{ it.value }}"{% endif %}>{{ it.value }}</b>{% if it.suffix %}<span class="stat-suffix">{{ it.suffix }}</span>{% endif %}</span>
    <span class="stat-label">{{ it.label }}</span>
  </li>
  {% endfor %}
</ul>
{%- endmacro %}

{% macro faq(items) -%}
<div class="faq">
  {% for it in items %}
  <details class="faq-item reveal" {% if loop.first %}open{% endif %}>
    <summary>{{ it.q }}<span class="faq-plus" aria-hidden="true"></span></summary>
    <div class="faq-a"><p>{{ it.a }}</p></div>
  </details>
  {% endfor %}
</div>
{%- endmacro %}

{% macro stars(n) -%}
<span class="stars" role="img" aria-label="{{ n }} / 5">{% for i in range(5) %}<span class="{{ 'on' if i < (n or 5)|round(0, 'floor') else '' }}">★</span>{% endfor %}</span>
{%- endmacro %}

{% macro reviews(items) -%}
<div class="carousel" data-carousel>
  <div class="car-track" tabindex="0">
    {% for r in items %}
    <figure class="review reveal">
      {{ stars(r.rating) }}
      <blockquote>{{ r.text }}</blockquote>
      <figcaption><b>{{ r.name }}</b>{% if r.source %}<span>{{ r.source }}</span>{% endif %}</figcaption>
    </figure>
    {% endfor %}
  </div>
  <div class="car-nav">
    <button type="button" data-prev aria-label="{{ ui.prev }}">{{ icon('arrow') }}</button>
    <button type="button" data-next aria-label="{{ ui.next }}">{{ icon('arrow') }}</button>
  </div>
</div>
{%- endmacro %}

{% macro doctors(items, cls='') -%}
<div class="docs {{ cls }}">
  {% for d in items %}
  <article class="doc reveal">
    <div class="doc-photo">
      {% if d.photo %}<img src="{{ root }}media/{{ d.photo }}" alt="{{ d.name }}" loading="lazy">{% else %}<div class="ph ph-person"><span>{{ initials(d.name) }}</span></div>{% endif %}
    </div>
    <div class="doc-body">
      <h3>{{ d.name }}</h3>
      {% if d.title %}<p class="doc-title">{{ d.title }}</p>{% endif %}
      {% if d.credentials %}<p class="doc-cred">{{ d.credentials }}</p>{% endif %}
      {% if d.bio %}<p class="doc-bio">{{ d.bio }}</p>{% endif %}
    </div>
  </article>
  {% endfor %}
</div>
{%- endmacro %}

{% macro journey(items, cls='') -%}
<ol class="journey {{ cls }}">
  {% for st in items %}
  <li class="jstep reveal">
    <span class="jnum">{{ '%02d' % loop.index }}</span>
    <h3>{{ st.title }}</h3>
    <p>{{ st.text }}</p>
  </li>
  {% endfor %}
</ol>
{%- endmacro %}

{# before/after comparison slider #}
{% macro slider(items) -%}
<div class="ba-wrap">
  {% for it in items %}
  <figure class="ba reveal" data-ba style="--pos:50%">
    <div class="ba-stage">
      <div class="ba-layer ba-after">{{ photo(it.after, ui.after ~ ' ' ~ (it.label or ''), 'ba-img', 'sparkle') }}</div>
      <div class="ba-layer ba-before">{{ photo(it.before, ui.before ~ ' ' ~ (it.label or ''), 'ba-img', 'layers') }}</div>
      <span class="ba-tag ba-tag-b">{{ ui.before }}</span><span class="ba-tag ba-tag-a">{{ ui.after }}</span>
      <span class="ba-handle" aria-hidden="true"></span>
      <input type="range" min="0" max="100" value="50" aria-label="{{ ui.drag }}">
    </div>
    <figcaption>{% if it.label %}<b>{{ it.label }}</b> · {% endif %}{{ ui.drag }}</figcaption>
  </figure>
  {% endfor %}
</div>
<p class="fine">{{ ui.results_note }}</p>
{%- endmacro %}

{% macro hours(h) -%}
{% if h is string %}<p>{{ h }}</p>{% elif h %}
<dl class="hours">{% for r in h %}<div><dt>{{ r.days }}</dt><dd>{{ r.time }}</dd></div>{% endfor %}</dl>{% endif %}
{%- endmacro %}

{# contact block: info + request form. variant classes handled in CSS #}
{% macro contact(opts=none) -%}
{% set c = s.contact or {} %}
{% set wa = c.whatsapp or c.phone %}
<div class="contact-grid">
  <div class="contact-info reveal">
    {% set locs = s.branches or [{'name': '', 'address': c.address, 'phone': c.phone, 'hours': c.hours, 'maps_url': c.maps_url}] %}
    {% for b in locs %}
    <div class="loc">
      {% if b.name %}<h3>{{ b.name }}</h3>{% endif %}
      {% if b.address %}<p class="loc-row">{{ icon('pin') }}<span>{{ b.address }}</span></p>{% endif %}
      {% if b.phone %}<p class="loc-row">{{ icon('phone') }}<a href="tel:{{ b.phone|digits }}" dir="ltr">{{ b.phone }}</a></p>{% endif %}
      {% if b.hours %}<div class="loc-row">{{ icon('clock') }}<div>{{ hours(b.hours) }}</div></div>{% endif %}
      {% if b.maps_url %}<a class="link-arrow" href="{{ b.maps_url }}" target="_blank" rel="noopener">{{ ui.directions }} {{ icon('arrow') }}</a>{% endif %}
    </div>
    {% endfor %}
    {% if c.email %}<p class="loc-row">{{ icon('mail') }}<a href="mailto:{{ c.email }}">{{ c.email }}</a></p>{% endif %}
  </div>
  <form class="form reveal" data-wa-form="{{ wa|digits }}" data-msg="{{ ui.form_msg }}" data-live="{{ 'true' if (s.live and wa) else 'false' }}" data-demo-note="{{ ui.demo_form_note }}">
    <h3>{{ ui.form_title }}</h3>
    <label><span>{{ ui.form_name }}</span><input name="n" required autocomplete="name"></label>
    <label><span>{{ ui.form_phone }}</span><input name="p" type="tel" required autocomplete="tel" dir="ltr"></label>
    {% if s.services %}
    <label><span>{{ ui.form_service }}</span>
      <select name="s"><option value="">{{ ui.form_choose }}</option>{% for sv in s.services %}<option>{{ sv.title }}</option>{% endfor %}</select>
    </label>
    {% endif %}
    <label><span>{{ ui.form_message }}</span><textarea name="m" rows="3"></textarea></label>
    <button class="btn btn-primary" type="submit">{{ icon('chat') }} {{ ui.form_send if (s.live and wa) else ui.form_send_demo }}</button>
    <p class="fine form-status" role="status">{{ ui.form_note }}</p>
  </form>
</div>
{%- endmacro %}
